<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ollin.Editor.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="Ollin.Bg" Color="#0B0E14" />
      <SolidColorBrush x:Key="Ollin.Panel" Color="#121722" />
      <SolidColorBrush x:Key="Ollin.PanelAlt" Color="#19212E" />
      <SolidColorBrush x:Key="Ollin.Border" Color="#2B3749" />
      <SolidColorBrush x:Key="Ollin.Text" Color="#E6ECF7" />
      <SolidColorBrush x:Key="Ollin.TextDim" Color="#93A4BC" />
      <SolidColorBrush x:Key="Ollin.Accent" Color="#F2A93B" />
      <SolidColorBrush x:Key="Ollin.AccentDim" Color="#8A6428" />
      <SolidColorBrush x:Key="Ollin.Jade" Color="#4FD1C5" />
      <SolidColorBrush x:Key="Ollin.Danger" Color="#E05B5B" />
      <SolidColorBrush x:Key="Ollin.ViewportBg" Color="#0B0D12" />
      <SolidColorBrush x:Key="Ollin.AccentHover" Color="#FFC15E" />
      <SolidColorBrush x:Key="Ollin.AccentText" Color="#1A1206" />
      <SolidColorBrush x:Key="Ollin.Hover" Color="#222C3B" />
      <SolidColorBrush x:Key="Ollin.Pressed" Color="#2A3648" />
      <SolidColorBrush x:Key="Ollin.Neutral" Color="#C7D0DE" />
          <SolidColorBrush x:Key="Ollin.Violet" Color="#9B8CFF" />
      <SolidColorBrush x:Key="Ollin.Surface" Color="#101621" />
      <SolidColorBrush x:Key="Ollin.BorderStrong" Color="#3A4A61" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Ollin.Editor/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
