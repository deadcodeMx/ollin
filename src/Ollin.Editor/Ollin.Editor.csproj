<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OllinTargetLinux>false</OllinTargetLinux>
    <OllinTargetLinux Condition="'$(RuntimeIdentifier)' == 'linux-x64' or $([MSBuild]::IsOSPlatform('Linux'))">true</OllinTargetLinux>
    <OutputType Condition="!$(OllinTargetLinux)">WinExe</OutputType>
    <OutputType Condition="$(OllinTargetLinux)">Exe</OutputType>
    <RootNamespace>Ollin.Editor</RootNamespace>
    <AssemblyName>Ollin.Editor</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="!$(OllinTargetLinux)">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="!$(OllinTargetLinux)">Assets\ollin.ico</ApplicationIcon>
    <DefineConstants Condition="!$(OllinTargetLinux)">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="OneWare.AvaloniaEdit" Version="11.3.20" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ollin.Core\Ollin.Core.csproj" />
    <ProjectReference Include="..\Ollin.Rendering\Ollin.Rendering.csproj" />
    <ProjectReference Include="..\Ollin.Runtime\Ollin.Runtime.csproj" />
    <ProjectReference Include="..\Ollin.Scripting\Ollin.Scripting.csproj" />
  </ItemGroup>
</Project>
