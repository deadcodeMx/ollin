<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Ollin.Editor.Controls"
        xmlns:ae="using:AvaloniaEdit"
        mc:Ignorable="d"
        x:Class="Ollin.Editor.Views.MainWindow"
        Title="{Binding Title}"
        Width="1500" Height="940"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/ollin.png"
        Background="{DynamicResource Ollin.Bg}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Menú -->
    <Menu Grid.Row="0">
      <MenuItem Header="Archivo">
        <MenuItem Header="Nuevo proyecto…" Click="OnNewProject" />
        <MenuItem Header="Abrir proyecto…" Click="OnOpenProject" />
        <MenuItem Header="Cerrar proyecto" Click="OnCloseProject" IsEnabled="{Binding HasProject}" />
        <Separator />
        <MenuItem Header="Nueva escena" InputGesture="Ctrl+N" Click="OnNewScene" />
        <MenuItem Header="Abrir escena…" InputGesture="Ctrl+O" Click="OnOpenScene" />
        <MenuItem Header="Guardar escena" InputGesture="Ctrl+S" Click="OnSaveScene" />
        <MenuItem Header="Guardar escena como…" Click="OnSaveSceneAs" />
        <Separator />
        <MenuItem Header="Exportar juego…" Click="OnExportGame" IsEnabled="{Binding HasProject}" />
        <Separator />
        <MenuItem Header="Salir" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="Edición">
        <MenuItem Header="Deshacer" InputGesture="Ctrl+Z" Click="OnUndo" />
        <MenuItem Header="Rehacer" InputGesture="Ctrl+Y" Click="OnRedo" />
        <Separator />
        <MenuItem Header="Copiar entidad" InputGesture="Ctrl+C" Click="OnCopyEntity" />
        <MenuItem Header="Pegar entidad" InputGesture="Ctrl+V" Click="OnPasteEntity" />
        <MenuItem Header="Guardar como prefab…" Click="OnSavePrefab" />
        <Separator />
        <MenuItem Header="Duplicar entidad" Click="OnDuplicate" />
        <MenuItem Header="Eliminar entidad" Click="OnDelete" />
        <Separator />
        <MenuItem Header="Abrir script de la selección" Click="OnOpenSelectedScript" />
      </MenuItem>
      <MenuItem Header="Ver">
        <MenuItem Header="Centrar cámara" InputGesture="Home" Click="OnResetCamera" />
        <MenuItem Header="Enfocar selección" InputGesture="F" Click="OnFrameSelected" />
        <MenuItem Header="Mostrar cuadrícula" ToggleType="CheckBox" IsChecked="{Binding ShowGrid}" />
        <Separator />
        <MenuItem Header="Ventana de juego" InputGesture="Ctrl+G" Click="OnOpenGameWindow" />
        <Separator />
        <MenuItem Header="Tema">
          <MenuItem Header="Oscuro" Click="OnThemeDark" />
          <MenuItem Header="Claro" Click="OnThemeLight" />
          <MenuItem Header="Ollin (logo)" Click="OnThemeOllin" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="Escena">
        <MenuItem Header="Reproducir / detener" InputGesture="F5" Click="OnPlay" />
        <MenuItem Header="Pausar / reanudar" InputGesture="F6" Click="OnPause" />
        <MenuItem Header="Detener y restaurar" Click="OnStopPlay" />
        <Separator />
        <MenuItem Header="Guardar partida" Click="OnSaveGame" />
        <MenuItem Header="Cargar partida" Click="OnLoadGame" />
      </MenuItem>
      <MenuItem Header="Ayuda">
        <MenuItem Header="Acerca de Ollin" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- Barra de herramientas -->
    <Border Grid.Row="1" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="tool" Content="Proyecto…" Click="OnNewProject" ToolTip.Tip="Crear o abrir un proyecto" />
          <Border Width="1" Background="{DynamicResource Ollin.Border}" Margin="6,2" />
          <Button Classes="tool" Content="Nueva" Click="OnNewScene" ToolTip.Tip="Nueva escena (Ctrl+N)" />
          <Button Classes="tool" Content="Abrir" Click="OnOpenScene" ToolTip.Tip="Abrir escena (Ctrl+O)" />
          <Button Classes="tool" Content="Guardar" Click="OnSaveScene" ToolTip.Tip="Guardar escena (Ctrl+S)" />
          <Button Classes="tool" Content="↶" Click="OnUndo" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoText}" />
          <Button Classes="tool" Content="↷" Click="OnRedo" IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoText}" />
          <Border Width="1" Background="{DynamicResource Ollin.Border}" Margin="6,2" />
          <Button Classes="tool" Content="+ Sprite" Click="OnAddSprite" />
          <Button Classes="tool" Content="+ Vacía" Click="OnAddEmpty" />
          <Button Classes="tool" Content="Duplicar" Click="OnDuplicate" />
          <Button Classes="tool" Content="Eliminar" Click="OnDelete" />
          <TextBlock Text="{Binding ProjectName}" VerticalAlignment="Center" Margin="10,0,0,0"
                     Foreground="{DynamicResource Ollin.Jade}" FontSize="11.5" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Classes="tool" Content="⟳ Scripts" Click="OnReloadScripts" ToolTip.Tip="Recompilar scripts" />
          <Button Classes="tool" Content="Centrar" Click="OnResetCamera" />
          <Button Classes="tool" Content="Enfocar" Click="OnFrameSelected" />
          <Border Width="1" Background="{DynamicResource Ollin.Border}" Margin="6,2" />
          <Button Classes="tool accent" Content="▶  Reproducir" Click="OnPlay"
                  IsEnabled="{Binding !IsPlaying}" ToolTip.Tip="Reproducir la escena (F5)" />
          <Button Classes="tool" Content="⏸  Pausa" Click="OnPause"
                  IsEnabled="{Binding IsPlaying}" ToolTip.Tip="Pausar o reanudar (F6)" />
          <Button Classes="tool" Content="⬆  Exportar" Click="OnExportGame"
                  IsEnabled="{Binding HasProject}" ToolTip.Tip="Exportar el juego como aplicación independiente" />
          <Button Classes="tool" Content="⏹  Detener" Click="OnStopPlay"
                  IsEnabled="{Binding IsPlaying}" ToolTip.Tip="Detener y restaurar la escena" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Cuerpo -->
    <Grid Grid.Row="2" RowDefinitions="*,4,230" Margin="8,8,8,6">

      <Grid Grid.Row="0" ColumnDefinitions="286,4,*,4,340">

        <!-- Jerarquía y assets -->
        <Border Grid.Column="0" Classes="card" IsEnabled="{Binding CanEdit}" Padding="0">
          <TabControl Background="Transparent" Padding="0">
            <TabItem Header="Jerarquía">
              <Grid RowDefinitions="Auto,Auto,*,Auto">
                <TextBlock Classes="section" Text="{Binding EntityCountText}" Margin="12,8,12,4" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="10,0,10,6">
                  <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Buscar entidad…" />
                  <Button Grid.Column="1" Classes="tool" Content="✕" Margin="6,0,0,0"
                          Click="OnClearSearch" IsVisible="{Binding HasSearch}" ToolTip.Tip="Quitar filtro" />
                </Grid>
                <TreeView Grid.Row="2" x:Name="SceneTree"
                          ItemsSource="{Binding Roots}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          DoubleTapped="OnHierarchyDoubleTapped"
                          Background="Transparent" Margin="4,0,4,4">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                      <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent">
                        <StackPanel.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Crear hijo" Click="OnCreateChild" />
                            <MenuItem Header="Añadir componente">
                              <MenuItem Header="Colisión (caja)" Click="OnAddCollider" />
                              <MenuItem Header="Disparador (trigger)" Click="OnAddTrigger" />
                              <MenuItem Header="Cuerpo físico" Click="OnAddRigidbody" />
                              <MenuItem Header="Cámara" Click="OnAddCameraComponent" />
                              <MenuItem Header="Animación" Click="OnAddAnimator" />
                              <MenuItem Header="Tilemap" Click="OnAddTilemap" />
                              <MenuItem Header="Audio" Click="OnAddAudio" />
                              <MenuItem Header="Rotador" Click="OnAddRotator" />
                              <MenuItem Header="Oscilador" Click="OnAddOscillator" />
                              <MenuItem Header="Script" Click="OnAddScriptComponent" />
                            </MenuItem>
                            <MenuItem Header="Quitar componente">
                              <MenuItem Header="Sprite" Tag="sprite" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Animación" Tag="animator" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Cámara" Tag="camera" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Tilemap" Tag="tilemap" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Colisión" Tag="collider" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Cuerpo físico" Tag="rigidbody" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Audio" Tag="audio" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Luz 2D" Tag="light" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Interacción" Tag="interactable" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Inventario" Tag="inventory" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Estadísticas" Tag="stats" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Día/Noche" Tag="daynight" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="IA" Tag="ai" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Cámara 3D" Tag="camera3d" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Pared 3D" Tag="wall3d" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Controlador FPS" Tag="fps" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Script" Tag="script" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Rotador" Tag="rotator" Click="OnRemoveComponentFromMenu" />
                              <MenuItem Header="Oscilador" Tag="oscillator" Click="OnRemoveComponentFromMenu" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Duplicar" Click="OnDuplicate" />
                            <MenuItem Header="Enfocar en la cámara" Click="OnFocusEntity" />
                            <MenuItem Header="Guardar como prefab…" Click="OnSavePrefab" />
                            <MenuItem Header="Guardar como blueprint…" Click="OnSaveBlueprint" />
                            <Separator />
                            <MenuItem Header="Eliminar" Click="OnDelete" />
                          </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="{Binding Icon}" FontSize="10"
                                   Foreground="{DynamicResource Ollin.Jade}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="10">
                  <Button Classes="tool" Content="+ Sprite" Click="OnAddSprite" />
                  <Button Classes="tool" Content="+ Vacía" Click="OnAddEmpty" />
                </StackPanel>
              </Grid>
            </TabItem>

            <TabItem Header="Assets">
              <Grid RowDefinitions="Auto,*" Margin="8,6,8,8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="{Binding AssetCountText}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="tool accent" Content="Asignar" Click="OnAssignAsset"
                            ToolTip.Tip="Asignar la textura a la entidad seleccionada" />
                    <Button Classes="tool" Content="Importar…" Click="OnImportAsset" />
                    <Button Classes="tool" Content="⟳" Click="OnReloadAssets" ToolTip.Tip="Recargar texturas" />
                  </StackPanel>
                </Grid>
                <ListBox Grid.Row="1" x:Name="AssetList" Margin="0,8,0,0"
                         KeyDown="OnAssetListKeyDown"
                         ItemsSource="{Binding Assets}"
                         SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                         DoubleTapped="OnAssignAsset"
                         Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="34,*" Margin="1,2">
                        <Border Width="32" Height="32" CornerRadius="4" Background="#0F1218"
                                BorderBrush="{DynamicResource Ollin.Border}" BorderThickness="1">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="11.5" />
                          <TextBlock Text="{Binding SizeText}" FontSize="10"
                                     Foreground="{DynamicResource Ollin.TextDim}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <!-- Documentos: escena o scripts -->
        <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True"
                Background="{DynamicResource Ollin.ViewportBg}">
          <Grid RowDefinitions="Auto,*">
            <!-- Pestañas de documento -->
            <Border Background="{DynamicResource Ollin.Panel}" Padding="6,4"
                    BorderBrush="{DynamicResource Ollin.Border}" BorderThickness="0,0,0,1">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Documents}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="doc" Classes.active="{Binding IsActive}"
                                Content="{Binding TitleWithDirty}" Tag="{Binding}" Click="OnSelectDocument" />
                        <Button Classes="docclose" Content="✕" Tag="{Binding}" Click="OnCloseDocument"
                                ToolTip.Tip="Cerrar pestaña" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <Grid Grid.Row="1">
              <!-- Viewport -->
              <Grid IsVisible="{Binding IsSceneActive}">
                <controls:ViewportSurface x:Name="ViewportHost" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                        Background="#D910131A" CornerRadius="6" Padding="10,5" IsHitTestVisible="False">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Scene.Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DirtyMarker}" Foreground="{DynamicResource Ollin.Accent}" />
                  </StackPanel>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                        Background="#D910131A" CornerRadius="6" Padding="10,5" IsHitTestVisible="False">
                  <TextBlock Text="{Binding Fps, StringFormat='{}{0} fps'}"
                             Foreground="{DynamicResource Ollin.TextDim}" FontSize="11" />
                </Border>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,12"
                           Classes="hint" IsHitTestVisible="False"
                           Text="Clic: seleccionar  ·  Rueda: zoom  ·  Alt + arrastrar: mover cámara" />

                <Border IsVisible="{Binding HasInteractionPrompt}" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="0,0,0,78"
                        Background="#E610131A" BorderBrush="{DynamicResource Ollin.Border}"
                        BorderThickness="1" CornerRadius="6" Padding="10,6" IsHitTestVisible="False">
                  <TextBlock Text="{Binding InteractionPrompt}" FontSize="12" />
                </Border>

                <Border IsVisible="{Binding IsDialogueActive}" VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch" Margin="70,0,70,18"
                        Background="#F0141822" BorderBrush="{DynamicResource Ollin.Accent}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12" IsHitTestVisible="False">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding DialogueSpeaker}" Foreground="{DynamicResource Ollin.Accent}"
                               FontWeight="SemiBold" FontSize="12.5" />
                    <TextBlock Text="{Binding DialogueText}" TextWrapping="Wrap" FontSize="14" />
                    <TextBlock Text="E / Espacio: continuar" FontSize="10"
                               Foreground="{DynamicResource Ollin.TextDim}" HorizontalAlignment="Right" />
                  </StackPanel>
                </Border>

                <!-- HUD de la partida -->
                <StackPanel IsVisible="{Binding IsHudVisible}" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="16,50,0,0" Spacing="8" Width="230" IsHitTestVisible="False">
                  <ItemsControl ItemsSource="{Binding HudBars}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="2" Margin="0,0,0,4">
                          <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="#E7EAF0" />
                          <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="9"
                                       Foreground="{Binding Brush}" Background="#5510131A" />
                          <TextBlock Text="{Binding ValueText}" FontSize="9.5" Foreground="#AAB4C4"
                                     HorizontalAlignment="Right" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding HudLabels}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Display}" FontSize="12" Foreground="#E7EAF0" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <ItemsControl IsVisible="{Binding IsHudVisible}" ItemsSource="{Binding HudMessages}"
                              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0"
                              IsHitTestVisible="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#CC10131A" CornerRadius="4" Padding="10,5" Margin="0,2">
                        <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#F2F5FA" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Menú de pausa -->
                <Border IsVisible="{Binding IsPauseMenuVisible}" Background="#B305070B">
                  <Border Background="{DynamicResource Ollin.Panel}" BorderBrush="{DynamicResource Ollin.Border}"
                          BorderThickness="1" CornerRadius="10" Padding="26" Width="330"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Pausa" FontSize="24" FontWeight="Bold"
                                 Foreground="{DynamicResource Ollin.Accent}" />
                      <Button Classes="accent" Content="Continuar" Click="OnResumeMenu" HorizontalAlignment="Stretch" />
                      <Button Content="Reiniciar escena" Click="OnRestartScene" HorizontalAlignment="Stretch" />
                      <Button Content="Detener" Click="OnStopFromMenu" HorizontalAlignment="Stretch" />
                      <Button Content="Guardar partida" Click="OnSaveGame" HorizontalAlignment="Stretch" />
                      <Button Content="Cargar partida" Click="OnLoadGame" HorizontalAlignment="Stretch" />
                      <Border Height="1" Background="{DynamicResource Ollin.Border}" Margin="0,4" />
                      <TextBlock Text="Volumen maestro" FontSize="11"
                                 Foreground="{DynamicResource Ollin.TextDim}" />
                      <Slider Value="{Binding MasterVolume, Mode=TwoWay}" Minimum="0" Maximum="1" />
                    </StackPanel>
                  </Border>
                </Border>

                <!-- Fin de partida -->
                <Border IsVisible="{Binding IsGameOverVisible}" Background="#D905070B">
                  <Border Background="{DynamicResource Ollin.Panel}" BorderBrush="{DynamicResource Ollin.Danger}"
                          BorderThickness="1" CornerRadius="10" Padding="26" Width="380"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="12">
                      <TextBlock Text="Fin de la partida" FontSize="22" FontWeight="Bold"
                                 Foreground="{DynamicResource Ollin.Danger}" />
                      <TextBlock Text="{Binding GameOverText}" TextWrapping="Wrap" FontSize="13" />
                      <Button Classes="accent" Content="Reintentar" Click="OnRestartScene" HorizontalAlignment="Stretch" />
                      <Button Content="Detener" Click="OnStopFromMenu" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Border>
                </Border>
                <Border IsVisible="{Binding #ViewportHost.Viewport.HasError}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#E6212026" BorderBrush="{DynamicResource Ollin.Danger}"
                        BorderThickness="1" CornerRadius="8" Padding="18" MaxWidth="560">
                  <StackPanel Spacing="6">
                    <TextBlock Text="No se pudo iniciar el viewport" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ollin.Danger}" />
                    <TextBlock Text="{Binding #ViewportHost.Viewport.ErrorText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Ollin.TextDim}" FontSize="11" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Editor de scripts -->
              <Grid IsVisible="{Binding IsScriptActive}" RowDefinitions="Auto,*" Background="#12151C">
                <Border Padding="10,6" BorderBrush="{DynamicResource Ollin.Border}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding ActiveScript.TitleWithDirty}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ActiveScript.FullPath}" FontSize="10.5"
                                 Foreground="{DynamicResource Ollin.TextDim}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ActiveScript.Text.Length, StringFormat='{}{0} caracteres'}" FontSize="10.5"
                                 Foreground="{DynamicResource Ollin.Jade}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Ctrl+S guarda y recarga" FontSize="10.5" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Ollin.TextDim}" />
                      <Button Classes="tool accent" Content="Guardar" Click="OnSaveScript" />
                    </StackPanel>
                  </Grid>
                </Border>
                <ae:TextEditor Grid.Row="1" x:Name="ScriptEditor"
                               FontFamily="Consolas, Cascadia Mono, Courier New, monospace"
                               FontSize="13" Padding="10,8"
                               Background="#0F1218" Foreground="#E7EAF0"
                               ShowLineNumbers="True" WordWrap="False" />
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />

        <!-- Inspector con pestañas -->
        <Border Grid.Column="4" Classes="card" IsEnabled="{Binding CanEdit}">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Classes="section" Text="INSPECTOR" Margin="14,10,14,2" />

            <Border Grid.Row="1" IsVisible="{Binding HasNoSelection}" Background="{DynamicResource Ollin.PanelAlt}"
                    CornerRadius="6" Padding="14" Margin="14,6" VerticalAlignment="Top">
              <StackPanel Spacing="4">
                <TextBlock Text="Nada seleccionado" FontWeight="SemiBold" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="Elige una entidad en la jerarquía o haz clic sobre un sprite en el viewport." />
              </StackPanel>
            </Border>

            <TabControl Grid.Row="1" IsVisible="{Binding HasSelection}" Margin="6,0,6,6" Padding="0">
              <TabItem Header="Entidad">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="section" Text="NOMBRE" />
                      <TextBox Text="{Binding Selected.Name, Mode=TwoWay}" />
                      <TextBlock Classes="hint" Text="{Binding Selected.ComponentsSummary}" />
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Etiquetas" VerticalAlignment="Center" Classes="hint" />
                        <TextBox Grid.Column="1" Text="{Binding Selected.TagsText, Mode=TwoWay}" Watermark="player, enemy" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Símbolo" VerticalAlignment="Center" Classes="hint" />
                        <TextBox Grid.Column="1" Text="{Binding Selected.EditorIcon, Mode=TwoWay}" Watermark="★, 👾, ▲" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Color" VerticalAlignment="Center" Classes="hint" />
                        <TextBox Grid.Column="1" Text="{Binding Selected.EditorColorHex, Mode=TwoWay}" Watermark="#E9A23B" />
                      </Grid>
                      <Button Classes="tool accent" Content="+ Añadir componente" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="Colisión (caja)" Click="OnAddCollider" />
                            <MenuItem Header="Disparador (trigger)" Click="OnAddTrigger" />
                            <MenuItem Header="Cuerpo físico" Click="OnAddRigidbody" />
                            <MenuItem Header="Cámara" Click="OnAddCameraComponent" />
                            <MenuItem Header="Animación" Click="OnAddAnimator" />
                            <MenuItem Header="Tilemap" Click="OnAddTilemap" />
                            <MenuItem Header="Audio" Click="OnAddAudio" />
                            <MenuItem Header="Luz 2D" Click="OnAddLight" />
                            <MenuItem Header="Inventario" Click="OnAddInventory" />
                            <MenuItem Header="Estadísticas" Click="OnAddStats" />
                            <MenuItem Header="Día/Noche" Click="OnAddDayNight" />
                            <MenuItem Header="IA (agente)" Click="OnAddAi" />
                            <MenuItem Header="Cámara 3D" Click="OnAddCamera3D" />
                            <MenuItem Header="Pared 3D" Click="OnAddWall3D" />
                            <MenuItem Header="Controlador FPS" Click="OnAddFps" />
                            <MenuItem Header="Rotador" Click="OnAddRotator" />
                            <MenuItem Header="Oscilador" Click="OnAddOscillator" />
                            <MenuItem Header="Script" Click="OnAddScriptComponent" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>

                    <StackPanel Spacing="5">
                      <TextBlock Classes="section" Text="TRANSFORMACIÓN" />
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Posición X" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.X, Mode=TwoWay}" Increment="0.1" FormatString="0.###" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Posición Y" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.Y, Mode=TwoWay}" Increment="0.1" FormatString="0.###" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Rotación°" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.RotationDegrees, Mode=TwoWay}" Increment="5" FormatString="0.#" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Escala X" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.ScaleX, Mode=TwoWay}" Increment="0.1" FormatString="0.###" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Escala Y" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.ScaleY, Mode=TwoWay}" Increment="0.1" FormatString="0.###" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Visual" IsVisible="{Binding Selected.HasSprite}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="6">
                    <TextBlock Classes="section" Text="SPRITE" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Textura" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.TexturePath, Mode=TwoWay}" Watermark="ruta/textura.png" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Vista" VerticalAlignment="Top" Margin="0,4,0,0" Classes="hint" />
                      <Border Grid.Column="1" Width="76" Height="76" HorizontalAlignment="Left"
                              CornerRadius="4" Background="#0F1218" Padding="3"
                              BorderBrush="{DynamicResource Ollin.Border}" BorderThickness="1">
                        <Image Source="{Binding Selected.TexturePreview}" Stretch="Uniform" />
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Color" VerticalAlignment="Center" Classes="hint" />
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding Selected.ColorHex, Mode=TwoWay}" Watermark="#RRGGBBAA" />
                        <Border Grid.Column="1" Width="26" Height="26" Margin="6,0,0,0" CornerRadius="4"
                                BorderThickness="1" BorderBrush="{DynamicResource Ollin.Border}"
                                Background="{Binding Selected.ColorBrush}" />
                      </Grid>
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Tamaño X" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.SpriteWidth, Mode=TwoWay}" Increment="0.1" Minimum="0.01" FormatString="0.###" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Tamaño Y" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.SpriteHeight, Mode=TwoWay}" Increment="0.1" Minimum="0.01" FormatString="0.###" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Orden" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.SortingOrder, Mode=TwoWay}" Increment="1" FormatString="0" />
                    </Grid>
                    <CheckBox Content="Voltear horizontalmente" IsChecked="{Binding Selected.FlipX, Mode=TwoWay}" FontSize="11.5" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Paralaje" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.Parallax, Mode=TwoWay}" Increment="0.1" Minimum="0" Maximum="1" FormatString="0.##" />
                    </Grid>

                    <StackPanel IsVisible="{Binding Selected.HasAnimator}" Spacing="5">
                      <Border Height="1" Background="{DynamicResource Ollin.Border}" Margin="0,4" />
                      <TextBlock Classes="section" Text="ANIMACIÓN" />
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Hoja" VerticalAlignment="Center" Classes="hint" />
                        <TextBox Grid.Column="1" Text="{Binding Selected.AnimationTexture, Mode=TwoWay}" Watermark="assets/sprites/hoja.png" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Cuadro ancho" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.FrameWidth, Mode=TwoWay}" Increment="1" Minimum="1" FormatString="0" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Cuadro alto" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.FrameHeight, Mode=TwoWay}" Increment="1" Minimum="1" FormatString="0" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Cuadros" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.FrameCount, Mode=TwoWay}" Increment="1" Minimum="1" FormatString="0" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="FPS" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.AnimationFps, Mode=TwoWay}" Increment="1" Minimum="0.1" FormatString="0.#" />
                      </Grid>
                      <CheckBox Content="Repetir en bucle" IsChecked="{Binding Selected.AnimationLoop, Mode=TwoWay}" FontSize="11.5" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Audio" IsVisible="{Binding Selected.HasAudio}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="5">
                    <TextBlock Classes="section" Text="AUDIO" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Clip" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.AudioClip, Mode=TwoWay}" Watermark="assets/audio/sonido.wav" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Volumen" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.AudioVolume, Mode=TwoWay}" Increment="0.1" Minimum="0" Maximum="1" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Entrada (s)" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.AudioFadeIn, Mode=TwoWay}" Increment="0.1" Minimum="0" FormatString="0.##" />
                    </Grid>
                    <CheckBox Content="En bucle" IsChecked="{Binding Selected.AudioLoop, Mode=TwoWay}" FontSize="11.5" />
                    <CheckBox Content="Reproducir al iniciar" IsChecked="{Binding Selected.AudioPlayOnStart, Mode=TwoWay}" FontSize="11.5" />
                    <CheckBox Content="Canal de música" IsChecked="{Binding Selected.AudioMusic, Mode=TwoWay}" FontSize="11.5" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Los scripts también pueden llamar a Audio.Play(&quot;assets/audio/x.wav&quot;)." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Interacción" IsVisible="{Binding Selected.HasInteractable}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="5">
                    <TextBlock Classes="section" Text="INTERACCIÓN" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Aviso" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.InteractionPrompt, Mode=TwoWay}" Watermark="E para interactuar" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Radio" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.InteractionRadius, Mode=TwoWay}" Increment="0.1" Minimum="0.1" FormatString="0.###" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Diálogo" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.DialogueId, Mode=TwoWay}" Watermark="nota (dialogs/nota.json)" />
                    </Grid>
                    <CheckBox Content="Solo una vez" IsChecked="{Binding Selected.InteractOnce, Mode=TwoWay}" FontSize="11.5" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="El jugador debe tener la etiqueta 'player'. El diálogo se busca en dialogs/&lt;id&gt;.json." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Inventario" IsVisible="{Binding Selected.HasInventory}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="6">
                    <TextBlock Classes="section" Text="INVENTARIO" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Capacidad" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.InventoryCapacity, Mode=TwoWay}" Increment="1" Minimum="1" FormatString="0" />
                    </Grid>
                    <TextBlock Text="{Binding Selected.InventorySummary}" TextWrapping="Wrap" Classes="hint" />
                    <TextBox Text="{Binding Selected.NewItemText, Mode=TwoWay}" Watermark="pocion x3" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Classes="tool accent" Content="Añadir" Click="OnAddItem" />
                      <Button Classes="tool" Content="Quitar" Click="OnRemoveItem" />
                      <Button Classes="tool" Content="Vaciar" Click="OnClearInventory" />
                    </StackPanel>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Formato: id o id xCantidad. Las definiciones viven en items/*.json." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Estadísticas" IsVisible="{Binding Selected.HasStats}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="6">
                    <TextBlock Classes="section" Text="ESTADÍSTICAS" />
                    <TextBlock Text="{Binding Selected.StatsSummary}" TextWrapping="Wrap" Classes="hint" />
                    <TextBox Text="{Binding Selected.NewStatText, Mode=TwoWay}" Watermark="vida=80, hambre+10, energía-5" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Classes="tool accent" Content="Aplicar" Click="OnApplyStat" />
                      <Button Classes="tool" Content="Vaciar" Click="OnClearStats" />
                    </StackPanel>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Sintaxis: nombre=valor, nombre+valor o nombre-valor. El desgaste por segundo se ajusta en el JSON." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Día/Noche" IsVisible="{Binding Selected.HasDayNight}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="6">
                    <TextBlock Classes="section" Text="CICLO DÍA/NOCHE" />
                    <TextBlock Text="{Binding Selected.ClockText}" FontSize="12" Foreground="{DynamicResource Ollin.Accent}" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Duración (s)" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.DayLength, Mode=TwoWay}" Increment="10" Minimum="5" FormatString="0" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Hora" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.TimeOfDay, Mode=TwoWay}" Increment="0.05" Minimum="0" Maximum="0.99" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Luz de día" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.DayAmbientHex, Mode=TwoWay}" Watermark="#FFF8EB" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Luz de noche" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.NightAmbientHex, Mode=TwoWay}" Watermark="#262E47" />
                    </Grid>
                    <CheckBox Content="Pausar el ciclo" IsChecked="{Binding Selected.DayPaused, Mode=TwoWay}" FontSize="11.5" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="El runtime aplica el ambiente resultante a las cámaras de la escena." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="IA" IsVisible="{Binding Selected.HasAi}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="5">
                    <TextBlock Classes="section" Text="AGENTE" />
                    <TextBlock Text="{Binding Selected.AiStatus}" FontSize="12"
                               Foreground="{DynamicResource Ollin.Accent}" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Objetivo" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.AiTargetTag, Mode=TwoWay}" Watermark="player" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Velocidad" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.AiSpeed, Mode=TwoWay}" Increment="0.1" Minimum="0.1" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Visión" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.AiVision, Mode=TwoWay}" Increment="0.5" Minimum="0.5" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Patrulla" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.AiPatrolRadius, Mode=TwoWay}" Increment="0.5" Minimum="0" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Repetir ruta" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.AiRefresh, Mode=TwoWay}" Increment="0.05" Minimum="0.1" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Memoria (s)" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.AiMemory, Mode=TwoWay}" Increment="0.5" Minimum="0" FormatString="0.##" />
                    </Grid>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Patrulla alrededor de su posición inicial y persigue al objetivo al verlo. Usa A* si hay un tilemap con 'Colisiona'." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Cámara 3D" IsVisible="{Binding Selected.HasCamera3D}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="5">
                    <TextBlock Classes="section" Text="CÁMARA 3D · 2.5D" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="FOV" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.Camera3DFov, Mode=TwoWay}" Increment="1" Minimum="20" Maximum="140" FormatString="0" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Altura ojos" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.Camera3DHeight, Mode=TwoWay}" Increment="0.1" Minimum="0.1" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Giro (Y)" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.Camera3DYaw, Mode=TwoWay}" Increment="5" FormatString="0" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Inclinación" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.Camera3DPitch, Mode=TwoWay}" Increment="5" Minimum="-80" Maximum="80" FormatString="0" />
                    </Grid>
                    <CheckBox Content="Niebla de distancia" IsChecked="{Binding Selected.Camera3DFogEnabled, Mode=TwoWay}" FontSize="11.5" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Niebla desde" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.Camera3DFogStart, Mode=TwoWay}" Increment="1" Minimum="0" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Niebla hasta" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.Camera3DFogEnd, Mode=TwoWay}" Increment="1" Minimum="0.1" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Fondo" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.Camera3DBackgroundHex, Mode=TwoWay}" Watermark="#0A0C14" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Color niebla" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.Camera3DFogHex, Mode=TwoWay}" Watermark="#141722" />
                    </Grid>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="La X del transform es ancho y la Y es profundidad. Añade un Controlador FPS a la misma entidad." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Pared 3D" IsVisible="{Binding Selected.HasWall3D}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="5">
                    <TextBlock Classes="section" Text="CAJA 3D" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Ancho" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.WallWidthInput, Mode=TwoWay}" Increment="0.5" Minimum="0.05" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Alto" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.WallHeight, Mode=TwoWay}" Increment="0.5" Minimum="0.05" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Profundidad" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.WallDepth, Mode=TwoWay}" Increment="0.5" Minimum="0.05" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Color" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.WallColorHex, Mode=TwoWay}" Watermark="#8A8F9C" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Textura" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.WallTexture, Mode=TwoWay}" Watermark="assets/sprites/tiles.png" />
                    </Grid>
                    <CheckBox Content="Visible" IsChecked="{Binding Selected.WallVisible, Mode=TwoWay}" FontSize="11.5" />
                    <CheckBox Content="Colisiona" IsChecked="{Binding Selected.WallCollides, Mode=TwoWay}" FontSize="11.5" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="La base descansa en el suelo (Y = 0). Usa cajas finas para suelos y techos sin colisión." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="FPS" IsVisible="{Binding Selected.HasFps}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="5">
                    <TextBlock Classes="section" Text="CONTROLADOR FPS" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Velocidad" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.FpsSpeed, Mode=TwoWay}" Increment="0.5" Minimum="0.1" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Correr (x)" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.FpsRun, Mode=TwoWay}" Increment="0.1" Minimum="1" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Sensibilidad" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.FpsSensitivity, Mode=TwoWay}" Increment="0.1" Minimum="0.1" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Radio" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.FpsRadius, Mode=TwoWay}" Increment="0.05" Minimum="0.05" FormatString="0.##" />
                    </Grid>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="WASD/flechas para moverte, ratón para mirar, Shift para correr. Colisiona con las cajas 3D." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Mundo">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="8">
                    <StackPanel IsVisible="{Binding Selected.HasCollider}" Spacing="5">
                      <TextBlock Classes="section" Text="COLISIÓN" />
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Ancho" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.ColliderWidth, Mode=TwoWay}" Increment="0.1" Minimum="0.01" FormatString="0.###" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Alto" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.ColliderHeight, Mode=TwoWay}" Increment="0.1" Minimum="0.01" FormatString="0.###" />
                      </Grid>
                      <CheckBox Content="Es disparador (trigger)" IsChecked="{Binding Selected.IsTrigger, Mode=TwoWay}" FontSize="11.5" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding Selected.HasRigidbody}" Spacing="5">
                      <TextBlock Classes="section" Text="CUERPO" />
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Velocidad X" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.VelocityX, Mode=TwoWay}" Increment="0.1" FormatString="0.###" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Velocidad Y" VerticalAlignment="Center" Classes="hint" />
                        <NumericUpDown Grid.Column="1" Value="{Binding Selected.VelocityY, Mode=TwoWay}" Increment="0.1" FormatString="0.###" />
                      </Grid>
                      <CheckBox Content="Afectado por gravedad" IsChecked="{Binding Selected.UseGravity, Mode=TwoWay}" FontSize="11.5" />
                      <CheckBox Content="Estático" IsChecked="{Binding Selected.IsStaticBody, Mode=TwoWay}" FontSize="11.5" />
                      <CheckBox Content="Cinemático (no lo empujan)" IsChecked="{Binding Selected.IsKinematicBody, Mode=TwoWay}" FontSize="11.5" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding Selected.HasScript}" Spacing="5">
                      <TextBlock Classes="section" Text="SCRIPT" />
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Archivo" VerticalAlignment="Center" Classes="hint" />
                        <TextBox Grid.Column="1" Text="{Binding Selected.ScriptPath, Mode=TwoWay}" Watermark="scripts/MiScript.cs" />
                      </Grid>
                      <Grid ColumnDefinitions="86,*" Margin="0,1">
                        <TextBlock Text="Clase" VerticalAlignment="Center" Classes="hint" />
                        <TextBox Grid.Column="1" Text="{Binding Selected.ScriptClass, Mode=TwoWay}" Watermark="NombreDeLaClase" />
                      </Grid>
                      <Button Classes="tool accent" Content="Abrir script" Click="OnOpenSelectedScript" HorizontalAlignment="Stretch" />
                      <Button Classes="tool" Content="Crear script para esta entidad" Click="OnCreateScript" HorizontalAlignment="Stretch" />
                      <Button Classes="tool" Content="Quitar script" Click="OnRemoveScript" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Tilemap" IsVisible="{Binding Selected.HasTilemap}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="5">
                    <TextBlock Classes="section" Text="TILEMAP" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Tileset" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.TilemapTexture, Mode=TwoWay}" Watermark="assets/sprites/tiles.png" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Ancho" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.TilemapWidth, Mode=TwoWay}" Increment="1" Minimum="1" FormatString="0" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Alto" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.TilemapHeight, Mode=TwoWay}" Increment="1" Minimum="1" FormatString="0" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Celda" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.TileSize, Mode=TwoWay}" Increment="0.25" Minimum="0.05" FormatString="0.###" />
                    </Grid>
                    <CheckBox Content="Pintar en el viewport" IsChecked="{Binding IsPaintingTiles, Mode=TwoWay}" FontSize="11.5" />
                    <CheckBox Content="Colisiona (bloquea cuerpos)" IsChecked="{Binding Selected.TilemapCollides, Mode=TwoWay}" FontSize="11.5" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Mosaico" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding PaintTileIndex, Mode=TwoWay}" Increment="1" Minimum="-1" FormatString="0" />
                    </Grid>
                    <TextBlock Classes="hint" Text="Clic pinta; -1 borra la celda." TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Luz" IsVisible="{Binding Selected.HasLight}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="5">
                    <TextBlock Classes="section" Text="LUZ 2D" />
                    <CheckBox Content="Cono (linterna)" IsChecked="{Binding Selected.LightIsCone, Mode=TwoWay}" FontSize="11.5" />
                    <CheckBox Content="Proyectar sombras" IsChecked="{Binding Selected.LightShadows, Mode=TwoWay}" FontSize="11.5" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Color" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.LightColorHex, Mode=TwoWay}" Watermark="#FFE0B0" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Radio" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.LightRadius, Mode=TwoWay}" Increment="0.5" Minimum="0.1" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Intensidad" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.LightIntensity, Mode=TwoWay}" Increment="0.1" Minimum="0" Maximum="2.5" FormatString="0.##" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Ángulo cono" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.LightConeAngle, Mode=TwoWay}" Increment="5" Minimum="10" Maximum="170" FormatString="0" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Parpadeo" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.LightFlicker, Mode=TwoWay}" Increment="0.05" Minimum="0" Maximum="1" FormatString="0.##" />
                    </Grid>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="La luz se dibuja aditiva sobre la escena. El ambiente de la cámara oscurece lo que no está iluminado." />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="Cámara" IsVisible="{Binding Selected.HasCamera}">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="5">
                    <TextBlock Classes="section" Text="CÁMARA" />
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Altura" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.OrthographicSize, Mode=TwoWay}" Increment="0.5" Minimum="0.1" FormatString="0.###" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Zoom" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.CameraZoom, Mode=TwoWay}" Increment="0.1" Minimum="0.05" FormatString="0.###" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Ambiente" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.AmbientHex, Mode=TwoWay}" Watermark="#RRGGBB (blanco = sin oscurecer)" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Seguir" VerticalAlignment="Center" Classes="hint" />
                      <TextBox Grid.Column="1" Text="{Binding Selected.FollowTag, Mode=TwoWay}" Watermark="player (vacío = fija)" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*" Margin="0,1">
                      <TextBlock Text="Suavizado" VerticalAlignment="Center" Classes="hint" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Selected.FollowSmoothing, Mode=TwoWay}" Increment="0.5" Minimum="0.1" FormatString="0.#" />
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />

      <!-- Dock inferior: consola y archivos -->
      <Border Grid.Row="2" Classes="card" Padding="0">
        <TabControl Background="Transparent" Padding="0">
          <TabItem Header="Consola">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="*,Auto" Margin="12,6,10,2">
                <TextBlock Classes="section" Text="CONSOLA" />
                <Button Grid.Column="1" Classes="tool" Content="Limpiar" Click="OnClearConsole" />
              </Grid>
              <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding Logs}"
                       Background="Transparent" Margin="4,0,4,6">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="58,52,*" Margin="2,1">
                      <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Ollin.TextDim}" FontSize="11" />
                      <TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="{Binding Brush}"
                                 FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{Binding Brush}"
                                 FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem Header="Archivos">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="*,Auto" Margin="12,6,10,2">
                <TextBlock Classes="section" Text="{Binding ProjectPathText}" />
                <Button Grid.Column="1" Classes="tool" Content="⟳" Click="OnRefreshFiles" ToolTip.Tip="Actualizar archivos" />
              </Grid>
              <TreeView Grid.Row="1" x:Name="FileTree" ItemsSource="{Binding ProjectFiles}" Background="Transparent"
                        Margin="4,0,4,6" DoubleTapped="OnFileDoubleTapped">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent">
                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Abrir" Click="OnFileMenuOpen" />
                          <Separator />
                          <MenuItem Header="Eliminar…" Click="OnFileMenuDelete" />
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                      <TextBlock Text="{Binding Icon}" FontSize="10" Width="18"
                                 Foreground="{DynamicResource Ollin.Jade}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>

      <!-- Bienvenida -->
      <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsWelcomeVisible}"
              Background="#F00B0D12" ZIndex="10">
        <Border Background="{DynamicResource Ollin.Panel}" CornerRadius="12" Padding="34"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="560"
                BorderBrush="{DynamicResource Ollin.Border}" BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Text="Ollin" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Ollin.Accent}" />
            <TextBlock Text="Motor de juego 2D · proyectos independientes" FontSize="13"
                       Foreground="{DynamicResource Ollin.TextDim}" />
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,6"
                       Text="Crea un proyecto nuevo con sus carpetas de escenas, scripts y assets, o abre uno existente. Cada proyecto es independiente y se guarda en su propia carpeta." />
            <Button Classes="accent" Content="Crear proyecto nuevo…" Click="OnNewProject" HorizontalAlignment="Stretch" />
            <Button Content="Abrir proyecto existente…" Click="OnOpenProject" HorizontalAlignment="Stretch" />
            <Button Classes="tool" Content="Abrir carpeta de ejemplo" Click="OnOpenSampleProject" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>
      </Border>
    </Grid>

    <!-- Estado -->
    <Border Grid.Row="3" Background="{DynamicResource Ollin.Panel}"
            BorderBrush="{DynamicResource Ollin.Border}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="12,4">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="{Binding StatusMessage}" FontSize="11" />
          <TextBlock Text="{Binding ScenePathText}" FontSize="11" Foreground="{DynamicResource Ollin.TextDim}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
          <TextBlock Text="{Binding ScriptStatusText}" FontSize="11" Foreground="{DynamicResource Ollin.TextDim}" />
          <TextBlock Text="{Binding PlayStateText}" FontSize="11" Foreground="{DynamicResource Ollin.Jade}" />
          <TextBlock Text="{Binding ElapsedText}" FontSize="11" Foreground="{DynamicResource Ollin.TextDim}" />
          <TextBlock Text="{Binding SelectionText}" FontSize="11" Foreground="{DynamicResource Ollin.Accent}" />
          <TextBlock Text="{Binding ZoomText}" FontSize="11" Foreground="{DynamicResource Ollin.TextDim}" />
          <TextBlock Text="{Binding Fps, StringFormat='{}{0} fps'}" FontSize="11" Foreground="{DynamicResource Ollin.TextDim}" />
          <TextBlock Text="{Binding DrawCalls, StringFormat='{}{0} llamadas'}" FontSize="11" Foreground="{DynamicResource Ollin.TextDim}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
