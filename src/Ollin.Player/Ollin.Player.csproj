<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Ollin.Player</RootNamespace>
    <AssemblyName>Ollin.Player</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\Ollin.Editor\Assets\ollin.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="BuildEditorBeforePlayer" BeforeTargets="ResolveAssemblyReferences">
    <MSBuild Projects="..\Ollin.Editor\Ollin.Editor.csproj" Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="OneWare.AvaloniaEdit" Version="11.3.20" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Ollin.Editor">
      <HintPath>..\Ollin.Editor\bin\$(Configuration)\net8.0\Ollin.Editor.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\Ollin.Core\Ollin.Core.csproj" />
    <ProjectReference Include="..\Ollin.Rendering\Ollin.Rendering.csproj" />
    <ProjectReference Include="..\Ollin.Runtime\Ollin.Runtime.csproj" />
    <ProjectReference Include="..\Ollin.Scripting\Ollin.Scripting.csproj" />
  </ItemGroup>
</Project>
