<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ollin.Player.PlayerHud"
             IsHitTestVisible="False">
  <Grid>
    <!-- HUD: barras y etiquetas -->
    <StackPanel IsVisible="{Binding IsHudVisible}" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="18,18,0,0" Spacing="8" Width="240">
      <ItemsControl ItemsSource="{Binding HudBars}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="2" Margin="0,0,0,4">
              <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#E7EAF0" />
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="9"
                           Foreground="{Binding Brush}" Background="#5510131A" />
              <TextBlock Text="{Binding ValueText}" FontSize="10" Foreground="#AAB4C4"
                         HorizontalAlignment="Right" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding HudLabels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Display}" FontSize="12" Foreground="#E7EAF0" TextWrapping="Wrap" MaxWidth="300" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Mensajes temporales -->
    <ItemsControl IsVisible="{Binding IsHudVisible}" ItemsSource="{Binding HudMessages}"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="#CC10131A" CornerRadius="5" Padding="11,6" Margin="0,2">
            <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#F2F5FA" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Diálogo -->
    <Border IsVisible="{Binding IsDialogueActive}" VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch" Margin="70,0,70,20"
            Background="#F0141822" BorderBrush="#E9A23B"
            BorderThickness="1" CornerRadius="8" Padding="18,13">
      <StackPanel Spacing="7">
        <TextBlock Text="{Binding DialogueSpeaker}" Foreground="#E9A23B"
                   FontWeight="SemiBold" FontSize="12.5" />
        <TextBlock Text="{Binding DialogueText}" TextWrapping="Wrap" FontSize="14" Foreground="#F2F5FA" />
        <TextBlock Text="E / Espacio: continuar" FontSize="10" Foreground="#8B94A7"
                   HorizontalAlignment="Right" />
      </StackPanel>
    </Border>

    <!-- Inventario -->
    <Border IsVisible="{Binding IsInventoryVisible}" Background="#B305070B">
      <Border Background="#151922" BorderBrush="#E9A23B" BorderThickness="1"
              CornerRadius="10" Padding="20" Width="430"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="INVENTARIO" FontSize="20" FontWeight="Bold" Foreground="#E9A23B" />
          <ItemsControl ItemsSource="{Binding InventoryItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="72" Height="72" Margin="3" CornerRadius="6" Background="#182030" BorderBrush="#2B3342" BorderThickness="1">
                  <Grid>
                    <TextBlock Text="{Binding Initial}" FontSize="26" FontWeight="Bold" Foreground="#E9A23B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding QuantityText}" FontSize="10" Foreground="#E7EAF0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" />
    <Border IsHitTestVisible="False" Opacity="{Binding TransitionOpacity}" Background="{Binding TransitionBrush}" />
    <ItemsControl IsVisible="{Binding IsUiVisible}" ItemsSource="{Binding UiElements}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}"
                  Background="#CC151922" BorderBrush="#40E9A23B" BorderThickness="1" CornerRadius="6"
                  IsVisible="{Binding Visible}" Padding="6">
            <Grid>
              <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="#F2F5FA" TextWrapping="Wrap" IsVisible="{Binding IsLabel}" VerticalAlignment="Center" />
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Value}" Height="12" IsVisible="{Binding IsBar}" />
              <Button Content="{Binding Text}" Command="{Binding Command}" IsVisible="{Binding IsButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="I para cerrar" FontSize="10" Foreground="#8B94A7" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Border>
    <!-- Fin de partida -->
    <Border IsVisible="{Binding IsGameOverVisible}" Background="#CC05070B">
      <Border Background="#151922" BorderBrush="#E05B5B" BorderThickness="1"
              CornerRadius="10" Padding="28" Width="340"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="Fin del juego" FontSize="22" FontWeight="Bold" Foreground="#E05B5B" />
          <TextBlock Text="{Binding GameOverText}" TextWrapping="Wrap" Foreground="#E7EAF0" />
          <TextBlock Text="Cierra con Esc" FontSize="10" Foreground="#8B94A7" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
